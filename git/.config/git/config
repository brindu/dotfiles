[push]
	default = upstream

[color]
	ui = true

[pull]
	rebase = true

[diff]
	algorithm = patience

[core]
	autocrlf = input
	editor = nvim
	whitespace = -trailing-space,-indent-with-non-tab,-tab-in-indent

[rebase]
	autostash = true
	required = true

[alias]
	aa = add --all
	a = add
	r = rebase
	rc = rebase --continue
	au = add -u
	st = status
	sw = switch
	d = diff -w
	br = branch
	ca = commit --amend
	ci = commit -v
	fix = commit --amend --no-edit
	bs = commit -m "Boyscout"
	co = checkout
	lg = log --pretty=format:'%C(bold)–%Creset %C(red bold)%h%d%Creset | %C(green)%an%Creset | %C(magenta)%cr%Creset | %C(cyan)%s%Creset'
	lgr = log --pretty=format:'%s'
	lgp = log -p
	lgn = log --name-only
	lgg = log --graph --decorate --oneline --all
	wip = commit -m "WIP"
	cancel = reset "HEAD^"
	report-csv = "log --format='\"%cd\",\"%cn\",\"%s\"' --date=short --no-merges"

[color "diff"]
	meta = "#7aa2f7"
	frag = "#7dcfff"
	old = "#f7768e"
	new = "#9ece6a"
	commit = "#e0af68"

[color "status"]
	branch = "#7dcfff"
	added = "#9ece6a"
	changed = "#e0af68"
	untracked = "#f7768e"

[color "branch"]
	current = "#9ece6a bold"
	local = "#c0caf5"
	remote = "#ff9e64"
	plain = "#565f89"

[color "decorate"]
	branch = "#7dcfff"
	remoteBranch = "#ff9e64"
	tag = "#e0af68"
	HEAD = "#bb9af7"

[include]
	path = ~/.config/git/config.local
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
