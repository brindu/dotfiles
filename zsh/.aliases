# Unix
alias tlf="tail -f"
alias mkdir='mkdir -p'
alias l='ls -la'
alias ll='ls -l'
alias lh='ls -Alh'
alias v="nvim"
alias tree="eza --tree --level=3"

# Postgres
alias psql="psql -d postgres"

# Bundler
alias b="bundle"
alias be="bundle exec"

# Rails / RSpec
alias rk="rake"
alias rs="b exec ./bin/rspec"
alias test-reset="RAILS_ENV=test rails db:environment:set db:setup"
alias rp="be rake parallel:spec"

# Shame
alias shame="rg -i '(TODO|FIXME|XXX)'"
alias SHAME="rg -i '((TODO|FIXME|XXX) ){3}'"

# git
alias gdiff='git -c pager.diff="delta --side-by-side" diff'

fliptable() { echo "（╯°□°）╯ ┻━┻"; }

# AI assistants
alias codex='codex --model gpt-6.1-sol -c model_reasoning_effort=high'
alias a="aider --no-auto-commits"
alias c="claude"
alias cw="claude --worktree"
alias cc="claude --continue"
alias cr="claude --resume"
alias wm="workmux"
alias wa="workmux add"

# Heroku
alias hr="heroku run"
