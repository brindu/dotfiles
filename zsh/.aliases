# Unix
alias tlf="tail -f"
alias mkdir='mkdir -p'
alias l='ls -la'
alias ll='ls -l'
alias lh='ls -Alh'
alias v="vim"
alias tree="tree -LAC 3"

# Postgres
alias psql="psql -d postgres"

# Bundler
alias b="bundle"
alias be="bundle exec"

# Rails / RSpec
alias rk="rake"
alias rs="b exec ./bin/rspec"
alias test-reset="RAILS_ENV=test rails db:environment:set db:setup"
alias rp="be rake parallel:spec"

# Shame
alias shame="ag -i '(TODO|FIXME|XXX)'"
alias SHAME="ag -i '((TODO|FIXME|XXX) ){3}'"

# git
alias gdiff='git difftool -y -x "colordiff -y -W $COLUMNS"'

fliptable() { echo "（╯°□°）╯ ┻━┻"; }

# AI assistants
alias a="aider --no-auto-commits"
alias c="claude"
alias cw="claude --worktree"
alias cc="claude --continue"
alias cr="claude --resume"
alias wm="workmux"
